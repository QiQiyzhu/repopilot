      "reference": "def solve(p):\n    order = []\n    done = set()\n    while True:\n        name = next((name for name, deps in p.items() if name not in done and all(dep in done for dep in deps)), None)\n        if name is None:\n            break\n        order.append(name)\n        done.add(name)\n    return {'order': order, 'blocked': [name for name in p if name not in done]}\n"
