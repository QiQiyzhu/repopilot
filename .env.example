# The default fake provider executes a labelled, deterministic demo; it is not a model.
REPOPILOT_DATA=.repopilot
REPOPILOT_REPO_ROOT=.
REPOPILOT_HOST=127.0.0.1
REPOPILOT_PORT=8000
# DeepSeek is the documented cloud default; CI/default demos still use fake.
# Server process variables only. No browser key, no key in a checked-in file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
REPOPILOT_PROVIDER_FLAVOR=deepseek
# Legacy OpenAI-compatible adapter settings remain available as explicit fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# deepseek: max_tokens + thinking.type=disabled. openai: max_completion_tokens.
# qwen: max_tokens + enable_thinking=false.
# compatible: max_tokens without vendor extensions. The run provider stays "openai".
# For Qwen set OPENAI_MODEL=qwen-plus, map OPENAI_API_KEY from DASHSCOPE_API_KEY,
# and replace OPENAI_BASE_URL with the complete regional/workspace URL from your console.
REPOPILOT_PROVIDER_TIMEOUT_SECONDS=45
# Optional cost rates in USD / 1M tokens; omitted means unknown (not zero).
REPOPILOT_INPUT_USD_PER_MILLION=
REPOPILOT_OUTPUT_USD_PER_MILLION=
